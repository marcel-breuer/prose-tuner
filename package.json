{
  "name": "prose-tuner",
  "version": "0.1.0",
  "description": "Provenance-safe editorial refinement for German and English text.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "prosetuner": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "release:check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && node scripts/verify-release.mjs && npm pack --dry-run",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.13"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
